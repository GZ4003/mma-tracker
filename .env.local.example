# Supabase Configuration
# Get these from your Supabase project dashboard: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ✓ That's it! Google OAuth is configured directly in Supabase Dashboard
# Authentication → Providers → Google

# Weekly training reminder email (cron: /api/cron/weekly-check)
# This is the Gmail account that SENDS the emails, not the recipient —
# each user gets emailed at their own address automatically.
# GMAIL_APP_PASSWORD is generated in Google Account → Security → App passwords
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here
# Random string that must match the Authorization header Vercel Cron sends
CRON_SECRET=a-random-secret-string
